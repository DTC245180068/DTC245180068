<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1">Quản lý Thanh toán & Dòng tiền</h3>
    <p class="text-muted mb-0 small">Nhật ký thu tiền, đối soát hóa đơn và các phương thức thanh toán</p>
  </div>
  <% if (openInvoices.length > 0) { %>
    <button type="button" class="btn btn-success rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#quickPaymentModal">
      <i class="bi bi-plus-circle"></i> Ghi nhận thanh toán mới
    </button>
  <% } %>
</div>

<!-- Filter & Search Bar -->
<div class="card mb-4 border-0 shadow-sm">
  <div class="card-body p-3 d-flex flex-wrap gap-3 align-items-center justify-content-between">
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <span class="text-muted small fw-bold px-1">Phương thức:</span>
      <button type="button" class="btn btn-sm btn-primary payment-method-pill rounded-pill active" data-method="ALL">Tất cả</button>
      <button type="button" class="btn btn-sm btn-outline-secondary payment-method-pill rounded-pill" data-method="BANK_TRANSFER">Chuyển khoản</button>
      <button type="button" class="btn btn-sm btn-outline-secondary payment-method-pill rounded-pill" data-method="CASH">Tiền mặt</button>
      <button type="button" class="btn btn-sm btn-outline-secondary payment-method-pill rounded-pill" data-method="CREDIT_CARD">Thẻ tín dụng</button>
      <button type="button" class="btn btn-sm btn-outline-secondary payment-method-pill rounded-pill" data-method="EWALLET">Ví điện tử</button>
    </div>
    <div class="d-flex align-items-center gap-2">
      <div class="input-group input-group-sm search-box-group shadow-sm">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="paymentSearchInput" class="form-control" placeholder="Tìm mã GD, số HĐ, khách hàng...">
      </div>
      <span id="paymentCountBadge" class="badge bg-light text-dark border font-monospace">Tổng: <%= payments.length %></span>
    </div>
  </div>
</div>

<!-- Payments Table Card -->
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle" id="payments-table">
      <thead>
        <tr>
          <th>Mã Giao dịch</th>
          <th>Số Hóa đơn</th>
          <th>Khách hàng</th>
          <th>Ngày thanh toán</th>
          <th>Phương thức</th>
          <th>Mã tham chiếu / Số UNC</th>
          <th>Số tiền thu</th>
          <th>Ghi chú</th>
        </tr>
      </thead>
      <tbody>
        <% if (payments.length === 0) { %>
          <tr><td colspan="8" class="text-center py-5 text-muted">Chưa có giao dịch thanh toán nào được ghi nhận</td></tr>
        <% } else { %>
          <% payments.forEach(p => { %>
            <tr data-method="<%= p.payment_method %>">
              <td class="font-monospace fw-bold text-dark"><%= p.payment_code %></td>
              <td class="font-monospace fw-bold text-primary">
                <a href="/invoices/<%= p.invoice_id %>" class="text-decoration-none"><%= p.invoice_number %></a>
              </td>
              <td>
                <div class="fw-semibold"><%= p.customer_name %></div>
                <small class="text-muted font-monospace"><%= p.customer_code %></small>
              </td>
              <td><%= new Date(p.payment_date).toLocaleDateString('vi-VN') %></td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary border">
                  <%= p.payment_method === 'BANK_TRANSFER' ? 'Chuyển khoản' : (p.payment_method === 'CASH' ? 'Tiền mặt' : p.payment_method) %>
                </span>
              </td>
              <td class="font-monospace small text-muted"><%= p.reference_no || '-' %></td>
              <td class="font-monospace fw-bold text-success fs-6">
                +<%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(p.amount) %>
              </td>
              <td class="small text-muted" style="max-width: 200px;"><%= p.notes || '-' %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Quick Payment Modal -->
<% if (openInvoices.length > 0) { %>
<div class="modal fade" id="quickPaymentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Ghi nhận Thanh toán Nhanh</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="form-record-payment">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Chọn Hóa đơn chưa thanh toán đủ <span class="text-danger">*</span></label>
            <select class="form-select" name="invoice_id" required>
              <% openInvoices.forEach(inv => { %>
                <option value="<%= inv.id %>">
                  <%= inv.invoice_number %> - Còn thiếu: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(inv.remaining) %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Số tiền thanh toán (VND) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" name="amount" min="1" step="any" required placeholder="Nhập số tiền...">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Phương thức thanh toán <span class="text-danger">*</span></label>
            <select class="form-select" name="payment_method" required>
              <option value="BANK_TRANSFER">Chuyển khoản Ngân hàng (Bank Transfer)</option>
              <option value="CASH">Tiền mặt (Cash)</option>
              <option value="CREDIT_CARD">Thẻ tín dụng / Ghi nợ (Credit Card)</option>
              <option value="EWALLET">Ví điện tử (Momo / ZaloPay)</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Mã tham chiếu / Số UNC</label>
            <input type="text" class="form-control font-monospace" name="reference_no" placeholder="FT2601994821">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Ngày thanh toán</label>
            <input type="date" class="form-control" name="payment_date" value="<%= new Date().toISOString().slice(0, 10) %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Ghi chú</label>
            <textarea class="form-control" name="notes" rows="2" placeholder="Ghi chú giao dịch..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success rounded-pill px-4">Xác nhận thanh toán</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
