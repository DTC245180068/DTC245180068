<%- include('partials/header') %>

<div class="mb-4">
  <a href="/invoices" class="btn btn-outline-secondary btn-sm mb-2 rounded-pill">
    <i class="bi bi-arrow-left"></i> Quay lại danh sách
  </a>
  <h3 class="fw-bold mb-1">Lập Hóa đơn Bán hàng / Cung cấp Dịch vụ</h3>
  <p class="text-muted small">Nhập thông tin khách hàng, danh sách sản phẩm dịch vụ và áp dụng thuế suất VAT</p>
</div>

<form id="form-create-invoice">
  <div class="row g-4 align-items-start">
    <!-- Left Column: Customer & Main Details -->
    <div class="col-12 col-lg-8">
      <div class="card mb-4">
        <div class="card-header">
          <i class="bi bi-person-badge me-2 text-primary"></i>Thông tin Khách hàng & Thời hạn
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Khách hàng / Đối tác <span class="text-danger">*</span></label>
              <select class="form-select" id="customer_id" required>
                <option value="">-- Chọn khách hàng --</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>" <%= (locals.selectedCustomerId && String(selectedCustomerId) === String(c.id)) ? 'selected' : '' %>><%= c.code %> - <%= c.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Số Hóa đơn (Để trống để tự tạo)</label>
              <input type="text" class="form-control font-monospace" id="invoice_number" placeholder="Ví dụ: INV-2026-0006">
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Ngày lập hóa đơn <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="issue_date" value="<%= new Date().toISOString().slice(0, 10) %>" required>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Hạn thanh toán <span class="text-danger">*</span></label>
              <% 
                const futureDate = new Date();
                futureDate.setDate(futureDate.getDate() + 30);
              %>
              <input type="date" class="form-control" id="due_date" value="<%= futureDate.toISOString().slice(0, 10) %>" required>
            </div>

            <div class="col-12">
              <label class="form-label small fw-bold">Ghi chú / Điều khoản thanh toán</label>
              <textarea class="form-control" id="notes" rows="2" placeholder="Ví dụ: Thanh toán qua chuyển khoản trong vòng 30 ngày kể từ ngày xuất hóa đơn"></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Line Items Card -->
      <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
          <div>
            <span class="fw-bold fs-6"><i class="bi bi-list-check me-2 text-primary"></i>Danh mục Hàng hóa / Dịch vụ</span>
            <div class="small text-muted mt-0.5"><i class="bi bi-info-circle me-1"></i>Thêm, sửa, xóa dịch vụ tự do. Bắt buộc có ít nhất 1 dịch vụ để lưu và phát hành hóa đơn.</div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm" id="btn-add-item">
            <i class="bi bi-plus-circle me-1"></i> Thêm dịch vụ
          </button>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0" id="items-table">
            <thead class="table-light">
              <tr>
                <th>Mô tả Sản phẩm / Dịch vụ</th>
                <th>Số lượng</th>
                <th>Đơn giá (VND)</th>
                <th class="text-end">Thành tiền</th>
                <th style="width: 50px;"></th>
              </tr>
            </thead>
            <tbody id="items-tbody">
              <tr class="item-row">
                <td><input type="text" class="form-control form-control-sm item-desc" placeholder="Tên sản phẩm / dịch vụ" value="Dịch vụ triển khai hệ thống Docker & Nginx" required></td>
                <td style="width: 120px;"><input type="number" class="form-control form-control-sm item-qty" value="1" min="1" required></td>
                <td style="width: 180px;"><input type="number" class="form-control form-control-sm item-price" value="15000000" min="0" step="any" required></td>
                <td style="width: 180px;" class="text-end fw-bold item-total font-monospace">15.000.000 ₫</td>
                <td style="width: 50px;" class="text-center">
                  <button type="button" class="btn btn-outline-danger btn-sm border-0 btn-remove-row" title="Xóa dòng dịch vụ này"><i class="bi bi-trash"></i></button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Right Column: Calculation Summary (Sticky on Desktop) -->
    <div class="col-12 col-lg-4 invoice-summary-col" style="align-self: flex-start;">
      <div class="card invoice-summary-card shadow-sm" style="position: sticky; top: 80px; z-index: 100;">
        <div class="card-header bg-white border-bottom py-3">
          <i class="bi bi-calculator me-2 text-primary"></i><strong>Tổng kết Thanh toán</strong>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Thuế suất GTGT (VAT %)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="tax_rate" value="10" min="0" max="100" step="any">
              <span class="input-group-text">%</span>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold">Chiết khấu / Giảm giá (VND)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="discount_amount" value="0" min="0" step="any">
              <span class="input-group-text">₫</span>
            </div>
          </div>

          <hr>

          <div class="d-flex justify-content-between mb-2 small text-muted">
            <span>Tiền hàng (Subtotal):</span>
            <span class="fw-semibold text-dark" id="calc-subtotal">0 ₫</span>
          </div>

          <div class="d-flex justify-content-between mb-2 small text-muted">
            <span>Tiền thuế VAT:</span>
            <span class="fw-semibold text-dark" id="calc-tax">0 ₫</span>
          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="fw-bold">Tổng thanh toán:</span>
            <span class="fs-4 fw-bold text-primary" id="calc-total">0 ₫</span>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm">
            <i class="bi bi-check-lg me-1"></i> Lưu và Phát hành Hóa đơn
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('partials/footer') %>
