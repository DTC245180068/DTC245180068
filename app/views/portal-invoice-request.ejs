<%- include('partials/header') %>

<div class="mb-4">
  <a href="/portal<%= (locals.currentUser && locals.currentUser.username) ? '?u=' + encodeURIComponent(locals.currentUser.username) : '' %>" class="btn btn-outline-secondary btn-sm mb-2 rounded-pill">
    <i class="bi bi-arrow-left"></i> Quay lại Bảng điều khiển Khách hàng
  </a>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-plus text-primary"></i>
        <span>Lập Yêu cầu Xuất Hóa đơn Dịch vụ</span>
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 rounded-pill">
          <i class="bi bi-clock-history me-1"></i>Chờ Kế toán xét duyệt
        </span>
      </h3>
      <p class="text-muted small mb-0">
        Điền thông tin danh mục dịch vụ cần xuất hóa đơn và gửi đến Ban Kế toán. Khi được phê duyệt, hệ thống sẽ tự động phát hành hóa đơn chính thức cho Quý khách.
      </p>
    </div>
  </div>
</div>

<form id="form-customer-invoice-request">
  <div class="row g-4 align-items-start">
    <!-- Left Column: Customer Info & Service Items -->
    <div class="col-12 col-lg-8">
      
      <!-- Card: Customer Info (Locked to logged-in customer) -->
      <div class="card mb-4 shadow-sm border-primary border-opacity-25">
        <div class="card-header bg-primary bg-opacity-10 py-3">
          <div class="d-flex align-items-center justify-content-between">
            <span class="fw-bold text-primary">
              <i class="bi bi-building-check me-2"></i>Thông tin Doanh nghiệp Yêu cầu (Khách hàng)
            </span>
            <span class="badge bg-primary text-white font-monospace"><%= customer ? customer.code : 'KH-DEMO' %></span>
          </div>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold text-muted">Tên Doanh nghiệp / Đơn vị tiếp nhận</label>
              <input type="text" class="form-control bg-light fw-semibold" value="<%= customer ? customer.name : '' %>" readonly>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold text-muted">Mã số thuế (MST)</label>
              <input type="text" class="form-control bg-light font-monospace" value="<%= customer && customer.tax_id ? customer.tax_id : 'Chưa cập nhật' %>" readonly>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold text-muted">Email nhận hóa đơn điện tử</label>
              <input type="text" class="form-control bg-light" value="<%= customer && customer.email ? customer.email : '' %>" readonly>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold text-muted">Số điện thoại liên hệ</label>
              <input type="text" class="form-control bg-light" value="<%= customer && customer.phone ? customer.phone : '' %>" readonly>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold text-muted">Địa chỉ xuất hóa đơn</label>
              <input type="text" class="form-control bg-light" value="<%= customer && customer.address ? customer.address : '' %>" readonly>
            </div>
          </div>
        </div>
      </div>

      <!-- Card: Request Date & Notes -->
      <div class="card mb-4 shadow-sm">
        <div class="card-header bg-white py-3">
          <i class="bi bi-calendar-event me-2 text-primary"></i><strong>Thời hạn & Điều khoản thanh toán</strong>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Ngày lập yêu cầu</label>
              <input type="date" class="form-control bg-light" id="req_issue_date" value="<%= new Date().toISOString().slice(0, 10) %>" readonly>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small fw-bold">Hạn thanh toán mong muốn <span class="text-danger">*</span></label>
              <% 
                const futureDate = new Date();
                futureDate.setDate(futureDate.getDate() + 30);
              %>
              <input type="date" class="form-control" id="req_due_date" value="<%= futureDate.toISOString().slice(0, 10) %>" required>
            </div>

            <div class="col-12">
              <label class="form-label small fw-bold">Ghi chú yêu cầu / Hợp đồng tham chiếu</label>
              <textarea class="form-control" id="req_notes" rows="2" placeholder="Ví dụ: Căn cứ hợp đồng dịch vụ số 2026/HĐKT-ICTU, đề nghị xuất hóa đơn cho đợt thanh toán giai đoạn 1."><%= prefillNotes || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Line Items Card (Service Items) -->
      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 bg-white">
          <div>
            <span class="fw-bold fs-6"><i class="bi bi-list-check me-2 text-primary"></i>Danh mục Dịch vụ / Hàng hóa yêu cầu</span>
            <div class="small text-muted mt-0.5"><i class="bi bi-info-circle me-1"></i>Thêm, sửa, xóa dịch vụ tự do. Bắt buộc có ít nhất 1 dịch vụ hợp lệ để gửi phê duyệt.</div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm" id="btn-cust-add-item">
            <i class="bi bi-plus-circle me-1"></i> Thêm dịch vụ
          </button>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0" id="cust-items-table">
            <thead class="table-light">
              <tr>
                <th>Mô tả Sản phẩm / Dịch vụ <span class="text-danger">*</span></th>
                <th style="width: 120px;">Số lượng</th>
                <th style="width: 180px;">Đơn giá (VND)</th>
                <th style="width: 180px;" class="text-end">Thành tiền</th>
                <th style="width: 50px;"></th>
              </tr>
            </thead>
            <tbody id="cust-items-tbody">
              <% if (prefillItems && prefillItems.length > 0) { %>
                <% prefillItems.forEach(item => { %>
                  <tr class="cust-item-row">
                    <td><input type="text" class="form-control form-control-sm cust-item-desc" placeholder="Tên sản phẩm / dịch vụ" value="<%= item.item_description %>" required></td>
                    <td><input type="number" class="form-control form-control-sm cust-item-qty" value="<%= item.quantity %>" min="1" required></td>
                    <td><input type="number" class="form-control form-control-sm cust-item-price" value="<%= item.unit_price %>" min="0" step="any" required></td>
                    <td class="text-end fw-bold cust-item-total font-monospace">0 ₫</td>
                    <td class="text-center">
                      <button type="button" class="btn btn-outline-danger btn-sm border-0 btn-cust-remove-row" title="Xóa dòng này"><i class="bi bi-trash"></i></button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr class="cust-item-row">
                  <td><input type="text" class="form-control form-control-sm cust-item-desc" placeholder="Tên sản phẩm / dịch vụ" value="Dịch vụ bảo trì và vận hành hệ thống phần mềm" required></td>
                  <td><input type="number" class="form-control form-control-sm cust-item-qty" value="1" min="1" required></td>
                  <td><input type="number" class="form-control form-control-sm cust-item-price" value="12000000" min="0" step="any" required></td>
                  <td class="text-end fw-bold cust-item-total font-monospace">12.000.000 ₫</td>
                  <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm border-0 btn-cust-remove-row" title="Xóa dòng này"><i class="bi bi-trash"></i></button>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Right Column: Calculation Summary (Sticky on Desktop) -->
    <div class="col-12 col-lg-4" style="align-self: flex-start;">
      <div class="card shadow-sm" style="position: sticky; top: 80px; z-index: 100;">
        <div class="card-header bg-white border-bottom py-3">
          <i class="bi bi-calculator me-2 text-primary"></i><strong>Tổng kết Chi phí Yêu cầu</strong>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Thuế suất GTGT (VAT %)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="req_tax_rate" value="10" min="0" max="100" step="any">
              <span class="input-group-text">%</span>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold">Chiết khấu / Ưu đãi (VND)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="req_discount_amount" value="0" min="0" step="any">
              <span class="input-group-text">₫</span>
            </div>
          </div>

          <hr>

          <div class="d-flex justify-content-between mb-2 small text-muted">
            <span>Tiền hàng (Subtotal):</span>
            <span class="fw-semibold text-dark" id="req-calc-subtotal">0 ₫</span>
          </div>

          <div class="d-flex justify-content-between mb-2 small text-muted">
            <span>Tiền thuế VAT:</span>
            <span class="fw-semibold text-dark" id="req-calc-tax">0 ₫</span>
          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="fw-bold">Tổng thanh toán dự kiến:</span>
            <span class="fs-4 fw-bold text-primary" id="req-calc-total">0 ₫</span>
          </div>

          <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 border-info border-opacity-25 bg-info-subtle text-info-emphasis">
            <i class="bi bi-shield-check me-1"></i> <strong>Quy trình phê duyệt:</strong> Sau khi gửi, yêu cầu sẽ được chuyển đến Kế toán kiểm tra. Quý khách có thể theo dõi tiến độ duyệt ngay tại trang cá nhân.
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-send-check-fill"></i> Gửi Yêu cầu Phê duyệt Hóa đơn
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('partials/footer') %>
