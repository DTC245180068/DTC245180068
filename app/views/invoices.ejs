<%- include('partials/header') %>

<% const isCustomer = locals.currentUser && locals.currentUser.role === 'CUSTOMER'; %>

<!-- ==================================================================== -->
<!-- 1. CUSTOMER DASHBOARD & PORTAL HEADER (BẢNG ĐIỀU KHIỂN DÀNH CHO KHÁCH HÀNG) -->
<!-- ==================================================================== -->
<% if (isCustomer) { %>
<div class="customer-portal-header mb-4 p-4 rounded-4 shadow-sm bg-white border border-primary border-opacity-25">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
        <h3 class="fw-bold mb-0 text-dark">Bảng điều khiển Khách hàng</h3>
        <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 py-1 px-3 rounded-pill">
          <i class="bi bi-shield-check me-1"></i>Cổng Dịch vụ Khách hàng Trực tuyến 24/7
        </span>
      </div>
      <p class="text-muted mb-0 small">
        Kính chào <strong><%= customerProfile ? customerProfile.name : locals.currentUser.full_name %></strong>
        <% if (customerProfile && customerProfile.code) { %>
          <span class="badge bg-light text-dark border font-monospace ms-1"><%= customerProfile.code %></span>
        <% } %>
        — Quản lý hóa đơn điện tử, tra cứu hạn thanh toán và thực hiện nghĩa vụ tài chính trực tuyến.
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/portal/request-invoice" class="btn btn-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5">
        <i class="bi bi-file-earmark-plus"></i> Lập yêu cầu hóa đơn mới
      </a>
      <button type="button" class="btn btn-outline-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" data-bs-toggle="modal" data-bs-target="#profileModal">
        <i class="bi bi-person-gear"></i> Hồ sơ & Địa chỉ nhận HĐ
      </button>
      <button type="button" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5" data-bs-toggle="modal" data-bs-target="#passwordModal">
        <i class="bi bi-key"></i> Đổi mật khẩu
      </button>
      <a href="#customer-requests-section" class="btn btn-outline-info rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5">
        <i class="bi bi-clipboard-check"></i> Yêu cầu của tôi
      </a>
      <a href="#customer-payments-section" class="btn btn-light border rounded-pill px-3 shadow-sm d-flex align-items-center gap-1.5">
        <i class="bi bi-receipt-cutoff text-primary"></i> Lịch sử thanh toán & Biên lai
      </a>
    </div>
  </div>
</div>

<!-- ==================================================================== -->
<!-- 1.1. THÔNG BÁO DẠNG FORM VỀ PHÊ DUYỆT YÊU CẦU HÓA ĐƠN CỦA KHÁCH HÀNG -->
<!-- ==================================================================== -->
<% if (locals.customerRequests && customerRequests.length > 0) { %>
  <% 
    const latestRejected = customerRequests.find(r => r.status === 'REJECTED');
    const latestApproved = customerRequests.find(r => r.status === 'APPROVED');
  %>

  <!-- THÔNG BÁO ĐỎ DẠNG FORM KHI KHÔNG ĐƯỢC DUYỆT (RED FORM NOTICE) -->
  <% if (latestRejected) { %>
    <div class="card border-danger border-2 shadow-sm rounded-4 mb-4 overflow-hidden position-relative" id="rejectedFormAlert" style="transition: opacity 0.6s ease, transform 0.6s ease, max-height 0.6s ease, margin 0.6s ease; max-height: 800px;">
      <!-- Thanh tiến trình đếm ngược 5 giây -->
      <div class="progress" style="height: 4px; border-radius: 0; background-color: rgba(220, 53, 69, 0.2);">
        <div id="rejectedProgressBar" class="progress-bar bg-danger" role="progressbar" style="width: 100%; transition: width 5s linear;"></div>
      </div>

      <div class="card-header bg-danger text-white py-2.5 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <i class="bi bi-x-octagon-fill fs-5"></i>
          <span class="fw-bold fs-6">THÔNG BÁO TỪ CHỐI: YÊU CẦU LẬP HÓA ĐƠN KHÔNG ĐƯỢC PHÊ DUYỆT</span>
          <span class="badge bg-white text-danger font-monospace px-2 py-0.5 rounded-pill shadow-xs d-inline-flex align-items-center gap-1" id="rejectedTimerBadge" style="font-size: 0.75rem;">
            <i class="bi bi-hourglass-split"></i> Tự đóng sau <span id="rejectedCountdownSec" class="fw-bold">5</span>s
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-white text-danger font-monospace px-3 py-1.5 rounded-pill shadow-xs">
            <i class="bi bi-x-circle-fill me-1"></i>KHÔNG DUYỆT / TỪ CHỐI
          </span>
          <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Đóng ngay thông báo này" onclick="dismissRejectedAlert()"></button>
        </div>
      </div>
      <div class="card-body p-4 bg-white">
        <div class="row g-3 align-items-start">
          <div class="col-12 col-lg-8">
            <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 mb-3">
              <div class="small fw-bold text-danger text-uppercase mb-1">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Lý do không duyệt từ Ban Kế toán / Quản trị viên:
              </div>
              <div class="fs-6 fw-bold text-danger ps-2 border-start border-3 border-danger">
                "<%= latestRejected.admin_notes || 'Thông tin dịch vụ chưa chính xác hoặc thiếu hợp đồng/biên bản đính kèm.' %>"
              </div>
              <div class="small text-muted mt-2 d-flex flex-wrap gap-3">
                <span><i class="bi bi-person-fill-slash me-1 text-danger"></i>Người từ chối: <strong><%= latestRejected.reviewer_name || 'Kế toán viên' %></strong></span>
                <span><i class="bi bi-clock-history me-1"></i>Thời gian: <%= new Date(latestRejected.reviewed_at || latestRejected.updated_at).toLocaleString('vi-VN') %></span>
              </div>
            </div>

            <div class="p-2.5 rounded-3 bg-light border small text-secondary mb-2">
              <i class="bi bi-shield-x text-danger me-1"></i> <strong>Xác nhận an toàn:</strong> Yêu cầu này <strong>hoàn toàn KHÔNG tạo bất kỳ hóa đơn nào</strong> trong hệ thống. Quý khách không phát sinh nghĩa vụ tài chính từ yêu cầu này.
            </div>

            <div class="small text-muted">
              Mã yêu cầu: <strong class="font-monospace text-dark"><%= latestRejected.request_code %></strong> &nbsp;|&nbsp;
              Ngày gửi: <%= new Date(latestRejected.issue_date).toLocaleDateString('vi-VN') %> &nbsp;|&nbsp;
              Số tiền yêu cầu: <strong class="font-monospace text-dark"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(latestRejected.total_amount) %></strong>
            </div>
          </div>

          <div class="col-12 col-lg-4 text-lg-end">
            <a href="/portal/request-invoice?copy_from=<%= latestRejected.id %>" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold w-100 mb-2 shadow-xs d-flex align-items-center justify-content-center gap-1.5">
              <i class="bi bi-arrow-repeat"></i> Chỉnh sửa & Gửi lại yêu cầu mới
            </a>
            <button type="button" class="btn btn-light border rounded-pill px-3 py-1.5 small text-muted w-100 btn-view-request-form" data-id="<%= latestRejected.id %>">
              <i class="bi bi-file-earmark-text"></i> Xem chi tiết phiếu yêu cầu
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var alertCard = document.getElementById('rejectedFormAlert');
        if (!alertCard) return;

        var pBar = document.getElementById('rejectedProgressBar');
        var secSpan = document.getElementById('rejectedCountdownSec');
        var secondsLeft = 5;
        var isPaused = false;
        var intervalTimer = null;

        // Bắt đầu thanh chạy tiến trình mượt mà
        if (pBar) {
          setTimeout(function() {
            pBar.style.width = '0%';
          }, 100);
        }

        // Đếm ngược 5 giây
        intervalTimer = setInterval(function() {
          if (isPaused) return;
          secondsLeft--;
          if (secSpan && secondsLeft >= 0) {
            secSpan.textContent = secondsLeft;
          }
          if (secondsLeft <= 0) {
            clearInterval(intervalTimer);
            dismissRejectedAlert();
          }
        }, 1000);

        // Tạm dừng khi người dùng rê chuột vào để đọc/thao tác
        alertCard.addEventListener('mouseenter', function() {
          isPaused = true;
          if (pBar) pBar.style.transitionPlayState = 'paused';
        });

        alertCard.addEventListener('mouseleave', function() {
          isPaused = false;
          if (pBar) pBar.style.transitionPlayState = 'running';
        });

        // Hàm ẩn mượt mà
        window.dismissRejectedAlert = function() {
          if (intervalTimer) clearInterval(intervalTimer);
          if (!alertCard) return;
          alertCard.style.opacity = '0';
          alertCard.style.transform = 'translateY(-15px)';
          setTimeout(function() {
            alertCard.style.maxHeight = '0px';
            alertCard.style.marginBottom = '0px';
            alertCard.style.padding = '0px';
            alertCard.style.borderWidth = '0px';
          }, 300);
          setTimeout(function() {
            if (alertCard.parentNode) {
              alertCard.remove();
            }
          }, 700);
        };
      })();
    </script>
  <% } %>

  <!-- THÔNG BÁO XANH DẠNG FORM KHI ĐƯỢC DUYỆT (GREEN FORM NOTICE) -->
  <% if (latestApproved) { %>
    <div class="card border-success border-2 shadow-sm rounded-4 mb-4 overflow-hidden position-relative" id="approvedFormAlert" style="transition: opacity 0.6s ease, transform 0.6s ease, max-height 0.6s ease, margin 0.6s ease; max-height: 800px;">
      <!-- Thanh tiến trình đếm ngược 5 giây -->
      <div class="progress" style="height: 4px; border-radius: 0; background-color: rgba(25, 135, 84, 0.2);">
        <div id="approvedProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 100%; transition: width 5s linear;"></div>
      </div>

      <div class="card-header bg-success text-white py-2.5 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <i class="bi bi-check-circle-fill fs-5"></i>
          <span class="fw-bold fs-6">THÔNG BÁO PHÊ DUYỆT: HÓA ĐƠN ĐÃ ĐƯỢC DUYỆT & PHÁT HÀNH THÀNH CÔNG!</span>
          <span class="badge bg-white text-success font-monospace px-2 py-0.5 rounded-pill shadow-xs d-inline-flex align-items-center gap-1" id="approvedTimerBadge" style="font-size: 0.75rem;">
            <i class="bi bi-hourglass-split"></i> Tự đóng sau <span id="approvedCountdownSec" class="fw-bold">5</span>s
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-white text-success font-monospace px-3 py-1.5 rounded-pill shadow-xs">
            <i class="bi bi-check2-all me-1"></i>ĐÃ DUYỆT & TẠO HÓA ĐƠN
          </span>
          <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Đóng ngay thông báo này" onclick="dismissApprovedAlert()"></button>
        </div>
      </div>
      <div class="card-body p-4 bg-white">
        <div class="row g-3 align-items-start">
          <div class="col-12 col-lg-8">
            <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 mb-3">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="small fw-bold text-success text-uppercase">Hóa đơn GTGT chính thức đã tạo:</span>
                <a href="/invoices/<%= latestApproved.invoice_id %>" class="badge bg-primary text-white font-monospace fs-6 text-decoration-none px-2.5 py-1 shadow-xs">
                  <i class="bi bi-file-earmark-text me-1"></i><%= latestApproved.linked_invoice_number || 'INV-2026-XXXX' %>
                </a>
              </div>
              <div class="small text-success-emphasis">
                <i class="bi bi-chat-quote-fill me-1"></i>Ghi chú Kế toán: <strong><%= latestApproved.admin_notes || 'Đã đối soát danh mục dịch vụ và phát hành hóa đơn điện tử' %></strong>
              </div>
              <div class="small text-muted mt-2 d-flex flex-wrap gap-3">
                <span><i class="bi bi-person-check-fill text-success me-1"></i>Người duyệt: <strong><%= latestApproved.reviewer_name || 'Kế toán viên' %></strong></span>
                <span><i class="bi bi-calendar-check me-1"></i>Ngày phê duyệt: <%= new Date(latestApproved.reviewed_at || latestApproved.updated_at).toLocaleString('vi-VN') %></span>
              </div>
            </div>

            <div class="small text-secondary">
              Mã yêu cầu gốc: <strong class="font-monospace text-dark"><%= latestApproved.request_code %></strong> &nbsp;|&nbsp;
              Tổng thanh toán: <strong class="font-monospace text-primary fs-6"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(latestApproved.total_amount) %></strong>
            </div>
          </div>

          <div class="col-12 col-lg-4 text-lg-end">
            <a href="/invoices/<%= latestApproved.invoice_id %>" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold w-100 mb-2 shadow-xs d-flex align-items-center justify-content-center gap-1.5">
              <i class="bi bi-printer"></i> Xem & Tải bản in Hóa đơn
            </a>
            <button type="button" class="btn btn-outline-success rounded-pill px-3 py-1.5 small w-100 btn-view-request-form" data-id="<%= latestApproved.id %>">
              <i class="bi bi-file-earmark-text"></i> Xem chi tiết phiếu yêu cầu
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var alertCard = document.getElementById('approvedFormAlert');
        if (!alertCard) return;

        var pBar = document.getElementById('approvedProgressBar');
        var secSpan = document.getElementById('approvedCountdownSec');
        var secondsLeft = 5;
        var isPaused = false;
        var intervalTimer = null;

        // Bắt đầu thanh chạy tiến trình mượt mà
        if (pBar) {
          setTimeout(function() {
            pBar.style.width = '0%';
          }, 100);
        }

        // Đếm ngược 5 giây
        intervalTimer = setInterval(function() {
          if (isPaused) return;
          secondsLeft--;
          if (secSpan && secondsLeft >= 0) {
            secSpan.textContent = secondsLeft;
          }
          if (secondsLeft <= 0) {
            clearInterval(intervalTimer);
            dismissApprovedAlert();
          }
        }, 1000);

        // Tạm dừng khi người dùng rê chuột vào để đọc/thao tác
        alertCard.addEventListener('mouseenter', function() {
          isPaused = true;
          if (pBar) pBar.style.transitionPlayState = 'paused';
        });

        alertCard.addEventListener('mouseleave', function() {
          isPaused = false;
          if (pBar) pBar.style.transitionPlayState = 'running';
        });

        // Hàm ẩn mượt mà
        window.dismissApprovedAlert = function() {
          if (intervalTimer) clearInterval(intervalTimer);
          if (!alertCard) return;
          alertCard.style.opacity = '0';
          alertCard.style.transform = 'translateY(-15px)';
          setTimeout(function() {
            alertCard.style.maxHeight = '0px';
            alertCard.style.marginBottom = '0px';
            alertCard.style.padding = '0px';
            alertCard.style.borderWidth = '0px';
          }, 300);
          setTimeout(function() {
            if (alertCard.parentNode) {
              alertCard.remove();
            }
          }, 700);
        };
      })();
    </script>
  <% } %>
<% } %>

<!-- ==================================================================== -->
<!-- 2. TÓM TẮT TÀI CHÍNH CÁ NHÂN (PERSONAL FINANCIAL SUMMARY - 4 KPI CARDS) -->
<!-- ==================================================================== -->
<div class="row g-3 mb-4">
  <!-- Card 1: Dư nợ hiện tại -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 <%= (customerSummary && customerSummary.totalDebt > 0) ? 'bg-danger-subtle border-start border-4 border-danger' : 'bg-success-subtle border-start border-4 border-success' %>">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="flex-grow-1" style="min-width: 0;">
          <span class="text-uppercase small fw-bold <%= (customerSummary && customerSummary.totalDebt > 0) ? 'text-danger' : 'text-success' %>">
            Dư nợ cần thanh toán
          </span>
          <h3 class="fw-bold my-2 font-monospace <%= (customerSummary && customerSummary.totalDebt > 0) ? 'text-danger' : 'text-success' %>">
            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(customerSummary ? customerSummary.totalDebt : 0) %>
          </h3>
          <div class="small <%= (customerSummary && customerSummary.totalDebt > 0) ? 'text-danger-emphasis' : 'text-success-emphasis' %>">
            <% if (customerSummary && customerSummary.totalDebt > 0) { %>
              <i class="bi bi-exclamation-circle-fill me-1"></i> Có <strong><%= customerSummary.unpaidCount %></strong> hóa đơn cần thanh toán
            <% } else { %>
              <i class="bi bi-check-circle-fill me-1"></i> Tuyệt vời! Không có dư nợ
            <% } %>
          </div>
        </div>
        <div class="customer-kpi-icon <%= (customerSummary && customerSummary.totalDebt > 0) ? 'danger' : 'success' %>">
          <i class="bi <%= (customerSummary && customerSummary.totalDebt > 0) ? 'bi-wallet2' : 'bi-shield-check' %>"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Tổng chi tiêu từ trước đến nay -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="flex-grow-1" style="min-width: 0;">
          <span class="text-uppercase small fw-bold text-primary">Tổng chi tiêu trọn đời</span>
          <h3 class="fw-bold my-2 font-monospace text-primary">
            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(customerSummary ? customerSummary.totalSpent : 0) %>
          </h3>
          <div class="small text-muted">
            <i class="bi bi-check2-all text-success me-1"></i> Đã tất toán <strong><%= customerSummary ? customerSummary.paidCount : 0 %></strong> hóa đơn thành công
          </div>
        </div>
        <div class="customer-kpi-icon primary">
          <i class="bi bi-piggy-bank-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Thống kê trạng thái hóa đơn -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-info">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="flex-grow-1" style="min-width: 0;">
          <span class="text-uppercase small fw-bold text-info">Tổng số hóa đơn của tôi</span>
          <h3 class="fw-bold my-2 font-monospace text-dark">
            <%= customerSummary ? customerSummary.totalInvoices : 0 %> <small class="fs-6 fw-normal text-muted">hóa đơn</small>
          </h3>
          <div class="d-flex flex-wrap gap-1 mt-1">
            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem;">
              <%= customerSummary ? customerSummary.paidCount : 0 %> Đã thu
            </span>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.72rem;">
              <%= customerSummary ? customerSummary.unpaidCount : 0 %> Chờ TT
            </span>
            <% if (customerSummary && customerSummary.overdueCount > 0) { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.72rem;">
                <%= customerSummary.overdueCount %> Quá hạn
              </span>
            <% } %>
          </div>
        </div>
        <div class="customer-kpi-icon info">
          <i class="bi bi-file-earmark-bar-graph"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4: Hồ sơ & Địa chỉ nhận Hóa đơn -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-secondary">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="flex-grow-1" style="min-width: 0;">
          <span class="text-uppercase small fw-bold text-secondary">Hồ sơ nhận hóa đơn</span>
          <div class="mt-1 small">
            <div class="text-truncate" title="<%= customerProfile ? (customerProfile.tax_id || '') : '' %>">
              <strong>MST:</strong> <%= customerProfile && customerProfile.tax_id ? customerProfile.tax_id : 'Chưa cập nhật' %>
            </div>
            <div class="text-truncate text-muted" title="<%= customerProfile ? (customerProfile.email || '') : '' %>">
              <strong>Email:</strong> <%= customerProfile && customerProfile.email ? customerProfile.email : 'Chưa cập nhật' %>
            </div>
            <div class="text-truncate text-muted" title="<%= customerProfile ? (customerProfile.address || '') : '' %>">
              <strong>Địa chỉ:</strong> <%= customerProfile && customerProfile.address ? customerProfile.address : 'Chưa cập nhật' %>
            </div>
          </div>
          <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-decoration-none fw-semibold" data-bs-toggle="modal" data-bs-target="#profileModal">
            <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa hồ sơ
          </button>
        </div>
        <div class="customer-kpi-icon secondary">
          <i class="bi bi-building-check"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==================================================================== -->
<!-- 3. CẢNH BÁO TÀI CHÍNH THÔNG MINH (SMART FINANCIAL ALERTS) -->
<!-- ==================================================================== -->
<% if (customerSummary && customerSummary.overdueCount > 0) { %>
  <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 rounded-4 shadow-sm mb-4">
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
      <div>
        <h6 class="fw-bold mb-1 text-danger">Cảnh báo: Bạn có <%= customerSummary.overdueCount %> hóa đơn đã quá hạn thanh toán!</h6>
        <div class="small text-danger-emphasis">
          Tổng dư nợ quá hạn là <strong><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(customerSummary.totalDebt) %></strong>. Quý khách vui lòng thực hiện thanh toán trực tuyến ngay qua VietQR hoặc Thẻ để tránh gián đoạn dịch vụ.
        </div>
      </div>
    </div>
    <a href="/invoices?status=OVERDUE" class="btn btn-danger btn-sm rounded-pill px-3 text-nowrap shadow-sm">
      Xem hóa đơn quá hạn
    </a>
  </div>
<% } else if (customerSummary && customerSummary.unpaidCount > 0) { %>
  <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 rounded-4 shadow-sm mb-4">
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-bell-fill fs-3 text-warning"></i>
      <div>
        <h6 class="fw-bold mb-1 text-warning-emphasis">Nhắc nhở thanh toán hóa đơn</h6>
        <div class="small text-muted">
          Bạn có <strong><%= customerSummary.unpaidCount %></strong> hóa đơn đang chờ thanh toán (Tổng số tiền: <strong><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(customerSummary.totalDebt) %></strong>). Bạn có thể bấm nút <strong>"Thanh toán ngay"</strong> ở bảng bên dưới để thanh toán tức thì 24/7.
        </div>
      </div>
    </div>
    <a href="/invoices?status=SENT" class="btn btn-warning btn-sm rounded-pill px-3 text-nowrap shadow-sm text-dark fw-semibold">
      Xem hóa đơn cần trả
    </a>
  </div>
<% } else { %>
  <div class="alert alert-success d-flex align-items-center justify-content-between p-3 rounded-4 shadow-sm mb-4">
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-shield-fill-check fs-3 text-success"></i>
      <div>
        <h6 class="fw-bold mb-1 text-success">Tài chính an toàn - Không có dư nợ quá hạn</h6>
        <div class="small text-success-emphasis">
          Toàn bộ các hóa đơn của Quý doanh nghiệp đều đã được thanh toán và tất toán đầy đủ. Cảm ơn sự hợp tác tin cậy của Quý khách!
        </div>
      </div>
    </div>
    <span class="badge bg-success rounded-pill px-3 py-2 font-monospace">HOÀN TẤT NGHĨA VỤ</span>
  </div>
<% } %>

<% } else { %>
<!-- ==================================================================== -->
<!-- ADMIN / ACCOUNTANT HEADER -->
<!-- ==================================================================== -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1 d-flex align-items-center flex-wrap gap-2">
      <span>Quản lý Hóa đơn</span>
      <% if (locals.currentUser && locals.currentUser.role === 'ACCOUNTANT') { %>
        <span class="badge bg-info-subtle text-info border border-info-subtle fs-6 py-1 px-2">
          <i class="bi bi-calculator me-1"></i>Nghiệp vụ Kế toán
        </span>
      <% } else { %>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 py-1 px-2">
          <i class="bi bi-shield-lock me-1"></i>Quản trị viên Hệ thống
        </span>
      <% } %>
    </h3>
    <p class="text-muted mb-0 small">
      Danh sách toàn bộ các hóa đơn bán hàng, lập hóa đơn mới, đối soát và quản lý dòng tiền
    </p>
  </div>
  <a href="/invoices/create" class="btn btn-primary rounded-pill px-3 d-flex align-items-center gap-1 shadow-sm">
    <i class="bi bi-plus-lg"></i> Lập hóa đơn mới
  </a>
</div>
<% } %>

<!-- ==================================================================== -->
<!-- 4. FILTER & SEARCH BAR -->
<!-- ==================================================================== -->
<div class="card mb-4 border-0 shadow-sm rounded-4">
  <div class="card-body p-3 d-flex flex-wrap gap-3 align-items-center justify-content-between">
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <span class="text-muted small fw-bold px-1">Lọc trạng thái:</span>
      <a href="/invoices" class="btn btn-sm <%= currentStatus === 'ALL' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">
        Tất cả (<%= invoices.length %>)
      </a>
      <a href="/invoices?status=SENT" class="btn btn-sm <%= currentStatus === 'SENT' ? 'btn-info text-white' : 'btn-outline-secondary' %> rounded-pill px-3">
        Chờ thanh toán (SENT)
      </a>
      <a href="/invoices?status=OVERDUE" class="btn btn-sm <%= currentStatus === 'OVERDUE' ? 'btn-danger' : 'btn-outline-secondary' %> rounded-pill px-3">
        Quá hạn (OVERDUE)
      </a>
      <a href="/invoices?status=PAID" class="btn btn-sm <%= currentStatus === 'PAID' ? 'btn-success' : 'btn-outline-secondary' %> rounded-pill px-3">
        Đã thanh toán (PAID)
      </a>
      <a href="/invoices?status=DRAFT" class="btn btn-sm <%= currentStatus === 'DRAFT' ? 'btn-secondary' : 'btn-outline-secondary' %> rounded-pill px-3">
        Bản nháp (DRAFT)
      </a>
    </div>

    <div class="d-flex align-items-center gap-2">
      <div class="input-group input-group-sm search-box-group shadow-sm">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="invoiceSearchInput" class="form-control" placeholder="Tìm theo mã HĐ, số tiền, ngày...">
      </div>
      <span id="invoiceCountBadge" class="badge bg-light text-dark border font-monospace">Tổng: <%= invoices.length %></span>
    </div>
  </div>
</div>

<!-- ==================================================================== -->
<!-- 5. DANH SÁCH HÓA ĐƠN (MY INVOICES TABLE) -->
<!-- ==================================================================== -->
<div class="card shadow-sm rounded-4 overflow-hidden mb-4 border-0">
  <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-file-earmark-text text-primary fs-5"></i>
      <h5 class="fw-bold mb-0"><%= isCustomer ? 'Danh sách Hóa đơn của tôi' : 'Danh mục Hóa đơn Hệ thống' %></h5>
    </div>
    <span class="badge bg-light text-muted border font-monospace">Hiển thị <%= invoices.length %> hóa đơn</span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle" id="invoices-table">
      <thead class="table-light">
        <tr>
          <th>Mã HĐ</th>
          <% if (!isCustomer) { %>
            <th>Khách hàng</th>
          <% } %>
          <th>Ngày lập</th>
          <th>Hạn thanh toán</th>
          <th>Tổng tiền (VND)</th>
          <th>Đã thanh toán</th>
          <th>Còn lại phải trả</th>
          <th>Trạng thái</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (invoices.length === 0) { %>
          <tr>
            <td colspan="<%= isCustomer ? '8' : '9' %>" class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 d-block text-secondary opacity-50 mb-2"></i>
              Không tìm thấy hóa đơn nào phù hợp với bộ lọc
            </td>
          </tr>
        <% } else { %>
          <% invoices.forEach(inv => { %>
            <% 
              const remaining = Math.max(0, parseFloat(inv.total_amount) - parseFloat(inv.paid_amount));
              const isOverdue = new Date(inv.due_date) < new Date() && inv.status !== 'PAID';
            %>
            <tr class="<%= (inv.status === 'OVERDUE' || isOverdue) ? 'table-danger-subtle' : '' %>">
              <td class="font-monospace fw-bold text-primary">
                <a href="/invoices/<%= inv.id %>" class="text-decoration-none">
                  <%= inv.invoice_number %>
                </a>
              </td>
              <% if (!isCustomer) { %>
              <td>
                <div class="fw-semibold"><%= inv.customer_name %></div>
                <small class="text-muted font-monospace"><%= inv.customer_code %></small>
              </td>
              <% } %>
              <td><%= new Date(inv.issue_date).toLocaleDateString('vi-VN') %></td>
              <td>
                <span class="<%= isOverdue ? 'text-danger fw-bold' : '' %>">
                  <%= new Date(inv.due_date).toLocaleDateString('vi-VN') %>
                </span>
                <% if (isOverdue) { %>
                  <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Quá hạn</span>
                <% } %>
              </td>
              <td class="fw-bold">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(inv.total_amount) %>
              </td>
              <td class="text-success fw-semibold font-monospace">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(inv.paid_amount) %>
              </td>
              <td class="font-monospace <%= remaining > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(remaining) %>
              </td>
              <td>
                <span class="badge-status <%= inv.status %>">
                  <%= inv.status === 'PAID' ? 'Đã thu' : (inv.status === 'SENT' ? 'Chờ thanh toán' : (inv.status === 'OVERDUE' ? 'Quá hạn' : inv.status)) %>
                </span>
              </td>
              <td class="text-end">
                <div class="d-inline-flex align-items-center gap-1.5">
                  <% if (isCustomer) { %>
                    <!-- THAO TÁC DÀNH CHO KHÁCH HÀNG -->
                    <% if (inv.status !== 'PAID' && remaining > 0) { %>
                      <!-- Nút Cổng thanh toán trực tuyến trực tiếp -->
                      <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm btn-customer-quickpay d-inline-flex align-items-center gap-1"
                              data-invoice-id="<%= inv.id %>"
                              data-invoice-number="<%= inv.invoice_number %>"
                              data-amount="<%= remaining %>"
                              data-total="<%= inv.total_amount %>"
                              data-customer-name="<%= inv.customer_name %>"
                              data-customer-code="<%= inv.customer_code %>">
                        <i class="bi bi-credit-card-2-front-fill"></i>
                        <span>Thanh toán ngay</span>
                      </button>
                    <% } else { %>
                      <!-- Đã thanh toán: Xem biên lai điện tử -->
                      <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2.5 btn-view-invoice-receipt"
                              data-invoice-id="<%= inv.id %>"
                              data-invoice-number="<%= inv.invoice_number %>"
                              title="Xem biên lai điện tử">
                        <i class="bi bi-file-earmark-check me-1"></i>Biên lai
                      </button>
                    <% } %>

                    <!-- Nút Xem chi tiết & In Hóa đơn PDF -->
                    <a href="/invoices/<%= inv.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" title="Xem chi tiết & In hóa đơn GTGT">
                      <i class="bi bi-printer me-1"></i>In HĐ
                    </a>

                  <% } else { %>
                    <!-- THAO TÁC DÀNH CHO ADMIN & KẾ TOÁN -->
                    <% if (inv.status === 'PAID') { %>
                      <a href="/invoices/<%= inv.id %>" class="btn btn-sm btn-outline-primary" title="Hóa đơn đã thu - Chỉ xem lại">
                        <i class="bi bi-eye me-1"></i>Xem
                      </a>
                    <% } else { %>
                      <div class="btn-group">
                        <a href="/invoices/<%= inv.id %>" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & In">
                          <i class="bi bi-eye"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                          <li><h6 class="dropdown-header">Đổi trạng thái</h6></li>
                          <li><button class="dropdown-item btn-update-status" data-invoice-id="<%= inv.id %>" data-status="PAID"><i class="bi bi-check-circle text-success me-2"></i>Đã thanh toán (PAID)</button></li>
                          <li><button class="dropdown-item btn-update-status" data-invoice-id="<%= inv.id %>" data-status="SENT"><i class="bi bi-send text-primary me-2"></i>Đã gửi (SENT)</button></li>
                          <li><button class="dropdown-item btn-update-status" data-invoice-id="<%= inv.id %>" data-status="OVERDUE"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Quá hạn (OVERDUE)</button></li>
                          <li><button class="dropdown-item btn-update-status" data-invoice-id="<%= inv.id %>" data-status="CANCELLED"><i class="bi bi-x-circle text-muted me-2"></i>Hủy hóa đơn</button></li>
                          <li><hr class="dropdown-divider"></li>
                          <li><button class="dropdown-item text-danger btn-delete-invoice" data-invoice-id="<%= inv.id %>" data-invoice-number="<%= inv.invoice_number %>"><i class="bi bi-trash text-danger me-2"></i>Xóa hóa đơn</button></li>
                        </ul>
                      </div>
                    <% } %>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ==================================================================== -->
<!-- 5.5. LỊCH SỬ YÊU CẦU XUẤT HÓA ĐƠN & PHÊ DUYỆT CỦA KHÁCH HÀNG -->
<!-- ==================================================================== -->
<% if (isCustomer) { %>
<div class="card shadow-sm rounded-4 overflow-hidden mb-4 border-0" id="customer-requests-section">
  <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-file-earmark-diff text-primary fs-5"></i>
      <h5 class="fw-bold mb-0">Lịch sử Yêu cầu Xuất Hóa đơn & Tiến độ Xét duyệt của tôi</h5>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
        <%= locals.customerRequests ? customerRequests.length : 0 %> yêu cầu đã gửi
      </span>
      <a href="/portal/request-invoice" class="btn btn-primary btn-sm rounded-pill px-3 shadow-xs">
        <i class="bi bi-plus-lg me-1"></i>Lập yêu cầu mới
      </a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Mã yêu cầu</th>
          <th>Ngày gửi</th>
          <th>Hạn thanh toán</th>
          <th class="text-center">Số dịch vụ</th>
          <th class="text-end">Tổng tiền dự kiến</th>
          <th class="text-center">Trạng thái phê duyệt</th>
          <th>Người duyệt / Ghi chú phản hồi</th>
          <th class="text-end">Phiếu yêu cầu</th>
        </tr>
      </thead>
      <tbody>
        <% if (!locals.customerRequests || customerRequests.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <i class="bi bi-inbox fs-2 d-block opacity-50 mb-1"></i>
              Quý khách chưa gửi yêu cầu xuất hóa đơn nào. Bấm nút <strong>"Lập yêu cầu mới"</strong> để gửi yêu cầu đến Kế toán.
            </td>
          </tr>
        <% } else { %>
          <% customerRequests.forEach(r => { %>
            <tr>
              <td class="font-monospace fw-bold text-primary">
                <%= r.request_code %>
              </td>
              <td class="small text-muted">
                <%= new Date(r.issue_date).toLocaleDateString('vi-VN') %>
              </td>
              <td class="small text-muted">
                <%= new Date(r.due_date).toLocaleDateString('vi-VN') %>
              </td>
              <td class="text-center">
                <span class="badge bg-light text-dark border"><%= (r.items ? r.items.length : 1) %> dịch vụ</span>
              </td>
              <td class="font-monospace fw-bold text-end">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(r.total_amount) %>
              </td>
              <td class="text-center">
                <% if (r.status === 'PENDING') { %>
                  <span class="badge bg-warning text-dark py-1 px-2.5 rounded-pill shadow-xs">
                    <i class="bi bi-hourglass-split me-1"></i>Chờ xét duyệt
                  </span>
                <% } else if (r.status === 'APPROVED') { %>
                  <span class="badge bg-success py-1 px-2.5 rounded-pill shadow-xs">
                    <i class="bi bi-check2-all me-1"></i>Đã phê duyệt
                  </span>
                  <% if (r.linked_invoice_number) { %>
                    <div class="mt-1">
                      <a href="/invoices/<%= r.invoice_id %>" class="small font-monospace text-decoration-none fw-bold text-primary">
                        <i class="bi bi-link-45deg"></i><%= r.linked_invoice_number %>
                      </a>
                    </div>
                  <% } %>
                <% } else if (r.status === 'REJECTED') { %>
                  <span class="badge bg-danger py-1 px-2.5 rounded-pill shadow-xs">
                    <i class="bi bi-x-circle-fill me-1"></i>Không duyệt
                  </span>
                <% } %>
              </td>
              <td class="small">
                <% if (r.status === 'REJECTED') { %>
                  <div class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i><%= r.admin_notes || 'Bị từ chối' %></div>
                  <div class="text-muted"><%= r.reviewer_name ? ('Bởi: ' + r.reviewer_name) : '' %></div>
                <% } else if (r.status === 'APPROVED') { %>
                  <div class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>Đã tạo HĐ <%= r.linked_invoice_number %></div>
                  <div class="text-muted"><%= r.reviewer_name ? ('Bởi: ' + r.reviewer_name) : '' %></div>
                <% } else { %>
                  <span class="text-muted italic">Đang chờ Kế toán thẩm định...</span>
                <% } %>
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 btn-view-request-form" data-id="<%= r.id %>">
                  <i class="bi bi-eye me-1"></i>Xem phiếu
                </button>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- ==================================================================== -->
<!-- 6. LỊCH SỬ GIAO DỊCH & BIÊN LAI ĐIỆN TỬ DÀNH CHO KHÁCH HÀNG -->
<!-- ==================================================================== -->
<% if (isCustomer) { %>
<div class="card shadow-sm rounded-4 overflow-hidden mb-4 border-0" id="customer-payments-section">
  <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-clock-history text-success fs-5"></i>
      <h5 class="fw-bold mb-0">Lịch sử Giao dịch & Biên lai Thu tiền Điện tử của tôi</h5>
    </div>
    <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">
      <%= customerPayments ? customerPayments.length : 0 %> giao dịch đã ghi nhận
    </span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Mã Biên lai / GD</th>
          <th>Hóa đơn liên quan</th>
          <th>Thời gian nộp tiền</th>
          <th>Phương thức thanh toán</th>
          <th>Mã tham chiếu / Số UNC</th>
          <th>Số tiền nộp (VND)</th>
          <th>Trạng thái</th>
          <th class="text-end">Biên lai điện tử</th>
        </tr>
      </thead>
      <tbody>
        <% if (!customerPayments || customerPayments.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <i class="bi bi-credit-card-2-back fs-2 d-block opacity-50 mb-1"></i>
              Chưa có giao dịch thanh toán nào được ghi nhận cho tài khoản này
            </td>
          </tr>
        <% } else { %>
          <% customerPayments.forEach(p => { %>
            <tr>
              <td class="font-monospace fw-bold text-success">
                <%= p.payment_code %>
              </td>
              <td>
                <a href="/invoices/<%= p.invoice_id %>" class="font-monospace text-decoration-none fw-semibold">
                  <%= p.invoice_number %>
                </a>
              </td>
              <td><%= new Date(p.payment_date).toLocaleDateString('vi-VN') %></td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary border">
                  <%= p.payment_method === 'BANK_TRANSFER' ? 'Chuyển khoản VietQR' : (p.payment_method === 'CREDIT_CARD' ? 'Thẻ Quốc tế' : (p.payment_method === 'EWALLET' ? 'Ví điện tử' : p.payment_method)) %>
                </span>
              </td>
              <td class="font-monospace small text-muted"><%= p.reference_no || '-' %></td>
              <td class="font-monospace fw-bold text-success">
                +<%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(p.amount) %>
              </td>
              <td>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  <i class="bi bi-check-circle-fill me-1"></i>Thành công
                </span>
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 btn-view-receipt-by-code"
                        data-payment-code="<%= p.payment_code %>"
                        data-payment-id="<%= p.id %>">
                  <i class="bi bi-receipt me-1"></i>Xem & In biên lai
                </button>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
